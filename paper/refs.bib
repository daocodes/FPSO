  journal = {Journal of Heuristics},
  volume  = {17},
  number  = {4},
  pages   = {373--387},
  year    = {2011},
  doi     = {10.1007/s10732-010-9138-y},
  note    = {CRITICAL PRIOR ART. Argues (a) the randomness of a heuristic's
             "optimal" solution can be driven small enough to ignore, and
             (b) the in-sample/out-of-sample relation is non-monotonic:
             past a point, in-sample gains buy only noise out of sample.
             Your contribution is the complement: at the budgets the applied
             literature ACTUALLY uses the randomness is not negligible, it
             exceeds published effect sizes, and closing the gap is
             systematically harmful rather than merely noisy.}
}

